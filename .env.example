# Configurações do Painel NPXManager
NPX_EMAIL=seu_email@empresa.com
NPX_PASSWORD=sua_senha_secreta

# Configurações do Integrador Local
PORT=3000
UPDATE_INTERVAL_SECONDS=5

# Limites de Alerta (SLA) para Fila e Tempo de Espera
# Fila de espera (número de pessoas)
ALERT_QUEUE_WARNING=2
ALERT_QUEUE_CRITICAL=4

# Tempo médio de espera (em segundos)
ALERT_WAIT_WARNING=180
ALERT_WAIT_CRITICAL=300
