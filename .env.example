# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO - INFOBOARD TV
# Preencha com as credenciais reais no momento da instalação
# ==============================================================================

# Configurações do Servidor
PORT=3001
UPDATE_INTERVAL_SECONDS=5
NODE_ENV=production
LOG_LEVEL=info

# TV: IPs diretos explicitamente autorizados (separados por vírgula).
INFOBOARD_TV_ALLOWED_IPS=
# Computadores de consulta: IPs diretos explicitamente autorizados, por virgula.
INFOBOARD_VIEWER_ALLOWED_IPS=
# Preserva acesso pela LAN e VPN IPv4 privada usado pela empresa.
# false exige loopback ou IPs individuais nas listas acima.
# Instalacoes antigas sem esta variavel preservam o acesso LAN/VPN.
INFOBOARD_ALLOW_PRIVATE_NETWORK=true
# Nomes DNS adicionais usados para acessar o painel (nome[:porta], por virgula).
# localhost, hostname local e IPs privados ja sao aceitos.
INFOBOARD_ALLOWED_HOSTS=
# Demonstração apenas quando solicitada; não altere .env sem verificar ambiente.
INFOBOARD_DEMO_MODE=false
# Configurações do NPXManager (Painel de Atendimento)
NPX_EMAIL=
NPX_PASSWORD=

# Usa o estado operacional do monitor oficial da NPX para cores dos analistas.
# 0 = desligado, 1 = livre, 2 = ocupado, 5 = chamando, -1 = pausa.
# Ativado por padrao; use false apenas para compatibilidade temporaria.
# O monitor nao confirma registro SIP; PBX confirmado tem prioridade.
INFOBOARD_NPX_REQUIRE_SIP_CONFIRMATION=true

# Configurações do PrixChat (Chat Online)
PRIXCHAT_EMAIL=
PRIXCHAT_PASSWORD=
PRIXCHAT_BACKEND=https://backapp.prixchat.com.br

# Credenciais de API do PBX (Nossa Telecom - Pabx)
# URL HTTPS oficial, com o hostname coberto pelo certificado do servidor.
PBX_BASE_URL=
PBX_API_TOKEN=
PBX_API_KEY=
# Preferir certificado valido ou CA interna via NODE_EXTRA_CA_CERTS.
# Desativar verificacao somente em ambiente legado administrado.
PBX_TLS_REJECT_UNAUTHORIZED=true

# Limites de Alerta (SLA) para Fila e Tempo de Espera
ALERT_QUEUE_WARNING=2
ALERT_QUEUE_CRITICAL=4
ALERT_WAIT_WARNING=180
ALERT_WAIT_CRITICAL=300

# Configurações do Telegram (Alertas de SLA de Chat - Opcional)
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SLA_LIMIT_SEC=420
