# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO - INFOBOARD TV
# Preencha com as credenciais reais no momento da instalação
# ==============================================================================

# Configurações do Servidor
PORT=3000
UPDATE_INTERVAL_SECONDS=5
NODE_ENV=production
LOG_LEVEL=info

# Configurações do NPXManager (Painel de Atendimento)
NPX_EMAIL=supervisor@suaempresa.com.br
NPX_PASSWORD=sua_senha_npx

# Configurações do PrixChat (Chat Online)
PRIXCHAT_EMAIL=painel@suaempresa.com.br
PRIXCHAT_PASSWORD=sua_senha_prixchat
PRIXCHAT_BACKEND=https://backapp.prixchat.com.br

# Credenciais de API do PBX (Nossa Telecom - Pabx)
PBX_BASE_URL=https://pbx.nossatelecom.com.br
PBX_API_TOKEN=seu_token_pbx
PBX_API_KEY=sua_chave_api_pbx

# Limites de Alerta (SLA) para Fila e Tempo de Espera
ALERT_QUEUE_WARNING=2
ALERT_QUEUE_CRITICAL=4
ALERT_WAIT_WARNING=180
ALERT_WAIT_CRITICAL=300

# Configurações do Telegram (Alertas de SLA de Chat - Opcional)
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SLA_LIMIT_SEC=420
